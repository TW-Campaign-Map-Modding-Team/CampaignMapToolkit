<UserControl x:Class="CAIME.Controls.CampaignMasksActionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CAIME.Controls"
             mc:Ignorable="d"
             ClipToBounds="True"
             d:DesignHeight="80"
             d:DesignWidth="250">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <Grid VerticalAlignment="Center"
              HorizontalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      MinWidth="140"
                      Margin="2 0"
                      Style="{StaticResource DarkFlatComboBox}"
                      ItemsSource="{Binding MaskNames}"
                      SelectedIndex="{Binding SelectedMaskIndex, Mode=TwoWay}"
                      ToolTip="The mask the layer shows and paints. A campaign uses the mask its campaigns row names, or no mask when it names none." />

            <Button Grid.Column="1"
                    Content="Add mask"
                    ToolTip="Adds a mask that masks no hexes yet."
                    Padding="5 3"
                    Margin="2 0"
                    Click="AddMask_Click"
                    Style="{StaticResource DarkButton}" />
        </Grid>

        <TextBlock Margin="2 4 2 0"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   Text="Add a mask to paint one."
                   Visibility="{Binding IsShownMaskReadOnly,
                                        Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
