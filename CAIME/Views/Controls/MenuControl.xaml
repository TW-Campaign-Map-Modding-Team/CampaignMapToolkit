<UserControl x:Class="CAIME.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CAIME"
             mc:Ignorable="d" 
             d:DesignHeight="40"
             d:DesignWidth="800">
    
    <StackPanel Orientation="Horizontal">
    <Menu Style="{StaticResource DarkMenu}">
        <MenuItem Header="File" >
            <MenuItem Header="Create new map"
                      InputGestureText="Ctrl+N"
                      Click="Create_Click" />

            <MenuItem Header="Open"
                      InputGestureText="Ctrl+O"
                      Click="Load_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsLoadItemEnabled}"/>

            <MenuItem Header="Reload"
                      InputGestureText="Ctrl+R"
                      Click="Reload_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsReloadItemEnabled}"/>

            <MenuItem Header="Save"
                      InputGestureText="Ctrl+S"
                      Click="Save_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsSaveItemEnabled}"/>

            <MenuItem Header="Save as..."
                      InputGestureText="Ctrl+Shift+S"
                      Click="SaveAs_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsSaveItemEnabled}"/>

            <MenuItem Header="Close"
                      InputGestureText="Ctrl+X"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsCloseItemEnabled}"
                      Click="Close_Click" />

            <MenuItem Header="Exit"
                      InputGestureText="Ctrl+Q"
                      Click="Exit_Click" />
        </MenuItem>
        
        <MenuItem Header="Edit" >
            <MenuItem Header="Undo"
                      InputGestureText="Ctrl+Z"
                      Command="{Binding MenuUndoCommand}"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsUndoItemEnabled}"/>
            <MenuItem Header="Redo"
                      InputGestureText="Ctrl+Y"
                      Command="{Binding MenuRedoCommand}"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsRedoItemEnabled}"/>
            <MenuItem Header="Resize"
                      InputGestureText="Ctrl+Shift+R"
                      Click="Resize_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsResizeEnabled}"/>
            <MenuItem Header="Rename map"
                      InputGestureText="Ctrl+Shift+N"
                      Click="RenameMap_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsRenameMapEnabled}"/>
        </MenuItem>

        <MenuItem Header="Process">
            <MenuItem Header="Map Data"
                          Click="ProcessMapData_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsProcessMapDataEnabled}"/>

            <MenuItem Header="Pathfinding data"
                          Click="ExportPathfinding_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsExportPathfindingEnabled}"/>

            <MenuItem Header="Borders data"
                          Click="ExportBorders_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsExportBordersEnabled}"/>

            <MenuItem Header="Dynamic resources"
                          Click="ProcessDynResources_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsProcessDynResEnabled}"/>

            <MenuItem Header="Trade Routes"
                          Click="ExportTradeRoutes_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsProcessTradeRoutesEnabled}"/>

            <MenuItem Header="Lookup and Minimap images"
                          Click="GenerateLookupMinimap_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsGenerateLookupEnabled}"/>
        </MenuItem>
        
        <MenuItem Header="Tools" >
            <MenuItem Header="Show Logger"
                      InputGestureText="Ctrl+L"
                      Click="LoggerTool_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsLoggerItemEnabled}"/>

            <MenuItem Header="Border Editor"
                      InputGestureText="Ctrl+B"
                      Click="BorderEditor_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsExportBordersEnabled}"/>

            <MenuItem Header="Map Data Editor"
                      InputGestureText="Ctrl+M"
                      Click="MapDataEditor_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsMapDataEditorEnabled}"/>

            <MenuItem Header="Shader Resolution Corrector"
                      Click="ShaderResolutionCorrector_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsShaderResolutionCorrectorEnabled}"/>

            <MenuItem Header="Import">
                <MenuItem Header="Layer data"
                          Click="ImportLayerData_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsImportLayerDataEnabled}"/>
            </MenuItem>

            <MenuItem Header="Export">
                <MenuItem Header="SVG Borders"
                          Click="ExportSVGBorders_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsExportSVGBordersEnabled}"/>

                <MenuItem Header="SVG Roads"
                          Click="ExportSVGRoads_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsExportSVGRoadsEnabled}"/>

                <MenuItem Header="Baseline Tilemap image"
                          Click="GenerateBaselineTilemap_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsExportLayerImagesEnabled}"/>

                <MenuItem Header="Layer data"
                          Click="ExportLayerToImage_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsExportLayerImagesEnabled}"/>
            </MenuItem>

            <MenuItem Header="Validate">
                <MenuItem Header="Impassable"
                          Click="ValidateImpassable_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsImpassableValidatorEnabled}"/>

                <MenuItem Header="Roads"
                        Click="ValidateRoads_Click"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsRoadsValidatorEnabled}"/>

                <MenuItem Header="Town slots"
                        Click="ValidateTownSlots_Click"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsTownSlotsValidatorEnabled}"/>

                <MenuItem Header="Town sprawl"
                        Click="ValidateSprawl_Click"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsSprawlValidatorEnabled}"/>

                <MenuItem Header="Bridges"
                        Click="ValidateBridges_Click"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsBridgesValidatorEnabled}"/>

                <MenuItem Header="Rivers"
                        Click="ValidateRivers_Click"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsRiversValidatorEnabled}"/>
                
                <MenuItem Header="Beaches"
                          Click="ValidateBeaches_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsBeachesValidatorEnabled}"/>

                <MenuItem Header="Regions"
                          Click="ValidateRegions_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsRegionsValidatorEnabled}"/>

                <MenuItem Header="Attritions"
                          Click="ValidateAttritions_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsAttritionsValidatorEnabled}"/>

                <MenuItem Header="Climates"
                          Click="ValidateClimates_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsClimatesValidatorEnabled}"/>

                <MenuItem Header="Ground types"
                          Click="ValidateGroundTypes_Click"
                          IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                              Path=IsGroundTypesValidatorEnabled}"/>
            </MenuItem>
            
        </MenuItem>
        <MenuItem Header="Settings" >
            <MenuItem Header="Preferences"
                      InputGestureText="Ctrl+P"
                      Click="Preferences_Click"/>

            <MenuItem Header="RPFM Workflow"
                      Click="PackFile_Click"
                      IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                          Path=IsCloseItemEnabled}"/>
        </MenuItem>
        
        <MenuItem Header="Help" >
            <MenuItem Header="About"
                      Click="About_Click"/>

            <MenuItem Header="License"
                      Click="License_Click"/>

            <MenuItem Header="EULA"
                      Click="Eula_Click"/>

            <MenuItem Header="Credits"
                      Click="Credits_Click"/>
            
            <Separator />

            <MenuItem Header="User Guides"
                      Click="Guides_Click"/>

            <MenuItem Header="Discord support server"
                      Click="DiscordSupport_Click"/>
        </MenuItem>
    </Menu>

        <TextBlock Text="{Binding SaveStateText}"
                   Foreground="{Binding SaveStateBrush}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Margin="12 0 0 0"/>
    </StackPanel>
</UserControl>
